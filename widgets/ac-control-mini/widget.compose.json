{
  "name": {
    "en": "AC Control Mini"
  },
  "height": 255,
  "transparent": true,
  "settings": [],
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "capabilities": "ac_mode"
    }
  },
  "api": {
    "getState": {
      "method": "GET",
      "path": "/state"
    },
    "setOnOff": {
      "method": "POST",
      "path": "/onoff"
    },
    "setTarget": {
      "method": "POST",
      "path": "/target"
    },
    "setMode": {
      "method": "POST",
      "path": "/mode"
    },
    "setFan": {
      "method": "POST",
      "path": "/fan"
    }
  }
}
